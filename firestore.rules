
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the user is authenticated and if their role in the /users/{uid} document is 'admin'
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      // Admins can read any user document, users can only read their own.
      allow get: if isOwner(userId) || isAdmin();
      // Admins can list all users.
      allow list: if isAdmin();
      // Users can create their own profile, admins can create any profile.
      allow create: if isOwner(userId) || isAdmin();
       // Admins can update any user document, users can only update their own.
      allow update: if isOwner(userId) || isAdmin();
      // No one can delete user profiles from the client.
      allow delete: if false;
    }

    // Rule for all user subcollections (e.g., crop_tracking, animal_tracking, reminders)
    match /users/{userId}/{subcollection}/{docId} {
       // Allow access if the user is the owner of the parent document OR if the user is an admin.
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Rules for public, read-only lesson collections
    match /crop_lessons/{lessonId} {
      // Allow any authenticated user to read lessons.
      allow read: if request.auth != null;
      // Do not allow writing to lessons through the client SDK.
      allow write: if false;
    }

    match /animal_lessons/{animalLessonId} {
       // Allow any authenticated user to read lessons.
      allow read: if request.auth != null;
       // Do not allow writing to lessons through the client SDK.
      allow write: if false;
    }
  }
}
