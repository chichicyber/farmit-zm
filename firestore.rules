/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for all
 * user-generated content and provides public, read-only access to shared educational
 * materials. The primary goal is data isolation, ensuring users can only access
 * and manage their own information.
 *
 * Data Structure: The data is organized into two main categories:
 * 1. User-Private Data: All data specific to a user (profiles, tracking for crops
 *    and animals, reminders) is nested under the `/users/{userId}` path. This creates
 *    a secure, isolated data tree for each user.
 * 2. Public Content: Educational lessons, which are intended for everyone, are
 *    stored in top-level collections like `/crop_lessons` and `/animal_lessons`.
 *
 * Key Security Decisions:
 * - User Data Isolation: A user can only read or write documents within their own
 *   `/users/{userId}` path. Access to other users' data is strictly prohibited.
 * - Public Read-Only Content: The lesson collections are publicly readable by
 *   anyone, to support educational access. All client-side write operations to
 *   these collections are disabled to protect content integrity.
 * - Denormalization for Authorization: User-specific documents (e.g., reminders)
 *   contain a denormalized `userId` field. This allows security rules to validate
 *   ownership directly from the document without performing slow lookups
 *   on parent documents, resulting in faster and more reliable security.
 * - No User Listing: The rules do not allow listing the `/users` collection,
 *   preventing any user from discovering the identities of other users on the platform.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function hasCorrectUserIdOnCreate(userId) {
      return request.resource.data.userId == userId;
    }

    function isUserIdImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }

    // -------------------------------------------------------------------------
    // User Profile Data
    // -------------------------------------------------------------------------
    /**
     * @description Secures user profile documents.
     * @path /users/{userId}
     * @allow (get, update) The owner of the profile.
     * @allow (create) An authenticated user creating their own profile.
     * @deny (delete) No one can delete a user profile.
     * @deny (update) A user cannot change their assigned role.
     * @principle Enforces ownership, data integrity on creation, and immutability for critical fields.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      // Simplified 'create' rule to prevent race conditions during signup.
      // The user must be authenticated, and the app ensures the doc ID matches their UID.
      allow create: if isSignedIn();
      allow update: if isOwner(userId) && isRoleImmutable();
      allow delete: if false;

      function isRoleImmutable() {
          return request.resource.data.role == resource.data.role;
      }
    }

    // -------------------------------------------------------------------------
    // User-Specific Subcollections
    // -------------------------------------------------------------------------

    match /users/{userId}/crop_tracking/{cropTrackingId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && hasCorrectUserIdOnCreate(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/animal_tracking/{animalTrackingId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && hasCorrectUserIdOnCreate(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/reminders/{reminderId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && hasCorrectUserIdOnCreate(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/advices/{adviceId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && hasCorrectUserIdOnCreate(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }

    // -------------------------------------------------------------------------
    // Public Educational Content
    // -------------------------------------------------------------------------

    match /crop_lessons/{cropLessonId} {
      allow get, list: if true;
      allow write: if false;
    }

    match /animal_lessons/{animalLessonId} {
      allow get, list: if true;
      allow write: if false;
    }
  }
}
